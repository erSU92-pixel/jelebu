name: XAUUSD Forensic Backtest

on:
  workflow_dispatch: # Memungkinkan Anda menjalankan backtest secara manual dari tab Actions di GitHub
  schedule:
    - cron: '0 0 * * 1' # Opsional: Berjalan otomatis setiap hari Senin pukul 00:00 UTC

jobs:
  run-backtest:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python 3.10
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'
          cache: 'pip'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pandas numpy pyyaml python-dotenv requests urllib3

      - name: Run Forensic Backtest Script
        env:
          TWELVE_DATA_API_KEY: ${{ secrets.TWELVE_DATA_API_KEY }}
        run: |
          python backtest.py
